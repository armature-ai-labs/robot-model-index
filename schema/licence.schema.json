{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/armature-ai-labs/robot-model-index/schema/licence.schema.json",
  "title": "Robot Model Index: licence entry",
  "description": "Plain-language summary of a licence that model entries refer to. Not legal advice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "url", "type", "commercial_use", "obligations", "status", "last_verified", "verified_by", "sources"],
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^s[0-9]+$"}}
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "name": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "version_checked": {"type": "string"},
    "type": {"enum": ["permissive", "copyleft", "custom-with-use-restrictions", "non-commercial", "proprietary"]},
    "commercial_use": {"enum": ["yes", "conditional", "no"]},
    "obligations": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["text", "sources"], "properties": {"text": {"type": "string"}, "sources": {"$ref": "#/$defs/sourceRefs"}}}
    },
    "status": {"enum": ["draft", "verified"]},
    "last_verified": {"$ref": "#/$defs/date"},
    "verified_by": {"type": "string"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "url", "title", "kind", "accessed"],
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]+$"},
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "kind": {"enum": ["primary"]},
          "accessed": {"$ref": "#/$defs/date"}
        }
      }
    }
  }
}
